# Copy to .env (gitignored). Expo inlines EXPO_PUBLIC_* into the bundle at build
# time, so only public values belong here: the anon key is public by design
# (RLS decides what it can read); a service-role key must never be here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The web app that serves /api/v1 — production by default.
EXPO_PUBLIC_API_URL=https://www.voinic.fit
