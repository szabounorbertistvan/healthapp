{
  "expo": {
    "name": "Voinic",
    "slug": "voinic",
    "scheme": "voinic",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b0b0d",
    "android": {
      "package": "fit.voinic.app",
      "versionCode": 1000,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0b0b0d"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0b0b0d"
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#d4a938"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
