{
  "expo": {
    "name": "Voinic",
    "slug": "voinic",
    "scheme": "voinic",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b0b0d",
    "ios": {
      "bundleIdentifier": "fit.voinic.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fit.voinic.app",
      "versionCode": 1000,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0b0b0d"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0b0b0d"
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Voinic uses the camera to scan food barcodes. / Voinic folosește camera ca să scaneze codurile de bare ale alimentelor.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#d4a938"
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Voinic uses your photos so you can add progress photos. / Voinic folosește pozele tale ca să poți adăuga poze de progres.",
          "cameraPermission": "Voinic uses the camera to take progress photos. / Voinic folosește camera ca să faci poze de progres.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Voinic uses the microphone only while you record a voice note for your coach. / Voinic folosește microfonul doar cât înregistrezi un mesaj vocal pentru antrenor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
