# Copy to .env.local and fill in from your Supabase project settings (API section).
# Both are required: there is no demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to 1 to log every Supabase round trip a page makes, with its duration,
# in the dev server output (lib/supabase/server.ts). Leave unset normally.
# SUPABASE_TRACE=1

# Stripe billing (optional — leave unset to disable checkout).
# 1. Run `node scripts/stripe-setup.mjs` once to create the products/prices.
# 2. Set the webhook secrets on Supabase:
#    supabase secrets set STRIPE_SECRET_KEY=sk_... STRIPE_WEBHOOK_SECRET=whsec_...
#    (webhook endpoint: https://<project>.supabase.co/functions/v1/stripe-webhook)
STRIPE_SECRET_KEY=
# Absolute origin used for Stripe redirect URLs (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push for the rest timer (optional — leave unset and the timer still works,
# minus the locked-phone notification). Generate with `node scripts/vapid-keys.mjs`;
# the private half goes to the edge function only:
#   supabase secrets set VAPID_KEYS_JSON='…' VAPID_SUBJECT='mailto:you@example.com'
#   supabase functions deploy rest-push
# and the cron tick needs two vault secrets (see migration 20260919100000).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# DishFinder (optional). The sibling restaurant/recipe product, docs/DISHFINDER.md.
# Set the origin AND the recipes flag and a planned meal gets a "recipes with
# these ingredients" link that opens DishFinder's /cooking with the meal's
# ingredients pre-selected (only when every food of the meal maps). Either unset
# = no link. The flag mirrors DishFinder's own ENABLE_PUBLIC_RECIPES: turn it on
# only once that side serves recipes publicly, or the link lands on a 503.
# No restaurant link on purpose: a dish out changes the grams the plan promises.
NEXT_PUBLIC_DISHFINDER_URL=https://dishfinder.food
NEXT_PUBLIC_DISHFINDER_RECIPES=

# Cloudinary (image uploads) — from the Cloudinary dashboard. Secret is server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
