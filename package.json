{
  "name": "healthapp",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev --workspace=@healthapp/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:offline": "node scripts/pgtest/run.mjs",
    "db:test:race": "node scripts/pgtest/race-bookings.mjs",
    "db:test:api": "node scripts/pgtest/api.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:gate": "node scripts/migration-gate.mjs",
    "seed:accounts": "node scripts/seed-accounts.mjs",
    "exercises:images": "node scripts/mirror-exercise-images.mjs",
    "exercises:translate": "node scripts/translate-exercises.mjs",
    "seed:exercises:sql": "node scripts/build-exercise-seed-sql.mjs",
    "seed:foods:sql": "vite-node scripts/build-food-seed-sql.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:local": "playwright test -c playwright.local.config.ts",
    "e2e:stack": "node scripts/pgtest/stack.mjs",
    "e2e:soak": "node scripts/soak.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@playwright/test": "^1.63.0",
    "supabase": "^2.22.6",
    "turbo": "^2.3.3",
    "typescript": "^5.8.0",
    "vitest": "^2.1.8"
  }
}
