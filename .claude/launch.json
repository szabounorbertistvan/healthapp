{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-attached",
      "url": "http://localhost:3000"
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--workspace=@healthapp/web",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}
